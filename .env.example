# ============================================================
# Portfolio Hamdani Hamka: Environment Variables
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai asli Anda
# Jangan commit file .env ke GitHub!
# ============================================================

# GitHub Username (sudah dikonfigurasi)
VITE_GITHUB_USERNAME=Hamznana

# GitHub Personal Access Token (OPSIONAL: untuk rate limit lebih tinggi)
# Tanpa token: 60 request/jam | Dengan token: 5000 request/jam
# Cara mendapatkan: GitHub > Settings > Developer Settings > Personal Access Tokens
# Pilih scope: public_repo (read only)
VITE_GITHUB_TOKEN=

# Supabase (diperlukan untuk: testimonials, visitor tracking, online users)
# Cara mendapatkan:
# 1. Buat project di https://supabase.com
# 2. Pergi ke Settings > API
# 3. Copy "Project URL" dan "anon public" key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


